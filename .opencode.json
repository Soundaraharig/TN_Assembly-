{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "nvidia": {
      "name": "NVIDIA NIM",
      "type": "openai",
      "baseURL": "https://integrate.api.nvidia.com/v1",
      "apiKey": "{env:NVIDIA_API_KEY}",
      "models": [
        "nvidia/nemotron-3.5-lightning-30b-a3b",
        "meta/llama-3.1-405b-instruct"
      ]
    },
    "deepseek": {
      "name": "DeepSeek",
      "type": "openai",
      "baseURL": "https://integrate.api.nvidia.com/v1",
      "apiKey": "{env:DEEPSEEK_API_KEY}",
      "models": [
        "deepseek-coder",
        "deepseek-chat"
      ]
    },
    "aws": {
      "name": "AWS Agent Toolkit",
      "type": "remote",
      "source": "aws-agent-toolkit",
      "region": "us-east-1",
      "profile": "soundarahari",
      "helpLevel": "MEDIUM"
    }
  },
  "awsExperience": "new",
  "awsRegion": "ap-south-1",
  "awsProfile": "soundarahari"
}